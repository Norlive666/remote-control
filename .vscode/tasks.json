{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "rc-tune",
      "detail": "命令面板输入 rc-tune 直接启动；会先问是否允许写入",
      "type": "shell",
      "command": "\"${workspaceFolder}/tools/rc-tune/start.sh\"",
      "windows": {
        "command": "\"${workspaceFolder}\\tools\\rc-tune\\start.bat\""
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "rc-tune: 与 Live Watch 一起启动",
      "detail": "先用 F5 启动 OpenOCD。自动找唯一的 ELF 和 Tcl 端口，允许 App 写入 g_rc",
      "type": "shell",
      "command": "\"${workspaceFolder}/tools/rc-tune/start.sh\"",
      "windows": {
        "command": "\"${workspaceFolder}\\tools\\rc-tune\\start.bat\""
      },
      "args": [
        "--backend",
        "openocd-tcl",
        "--allow-write"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "rc-tune: 与 Live Watch 一起启动（指定 ELF 和端口）",
      "detail": "自动识别失败时使用，端口填 F5 日志中的 tcl_port，允许 App 写入 g_rc",
      "type": "shell",
      "command": "\"${workspaceFolder}/tools/rc-tune/start.sh\"",
      "windows": {
        "command": "\"${workspaceFolder}\\tools\\rc-tune\\start.bat\""
      },
      "args": [
        "--backend",
        "openocd-tcl",
        "--elf",
        "${input:rcTuneElf}",
        "--ocd-port",
        "${input:rcTuneTclPort}",
        "--allow-write"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "rc-tune: 启动（先只读）",
      "detail": "连已运行的 OpenOCD（gdb_port 3333），自动找 ELF，开 HTTP 桥接器；用命令面板的「Tasks: Run Task」启动",
      "type": "shell",
      "command": "\"${workspaceFolder}/tools/rc-tune/start.sh\"",
      "windows": {
        "command": "\"${workspaceFolder}\\tools\\rc-tune\\start.bat\""
      },
      "args": [
        "--backend",
        "openocd",
        "--read-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "rc-tune: 启动（允许写入）",
      "detail": "同上，但允许把 App 的操作写进 g_rc。确认机器人已架空再跑",
      "type": "shell",
      "command": "\"${workspaceFolder}/tools/rc-tune/start.sh\"",
      "windows": {
        "command": "\"${workspaceFolder}\\tools\\rc-tune\\start.bat\""
      },
      "args": [
        "--backend",
        "openocd",
        "--allow-write"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "rc-tune: 启动（指定 ELF）",
      "detail": "自动查找不准时用；会弹框问固件路径，写入权限按终端里的提问回答",
      "type": "shell",
      "command": "\"${workspaceFolder}/tools/rc-tune/start.sh\"",
      "windows": {
        "command": "\"${workspaceFolder}\\tools\\rc-tune\\start.bat\""
      },
      "args": [
        "--backend",
        "openocd",
        "--elf",
        "${input:elfPath}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "rc-tune: 用 pyOCD 启动（自己占探针）",
      "detail": "没有 OpenOCD 时用；会独占 DAPLink，首次要装 15 MB 的 pyocd",
      "type": "shell",
      "command": "\"${workspaceFolder}/tools/rc-tune/start.sh\"",
      "windows": {
        "command": "\"${workspaceFolder}\\tools\\rc-tune\\start.bat\""
      },
      "args": [
        "--backend",
        "pyocd"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true,
        "showReuseMessage": false
      }
    }
  ],
  "inputs": [
    {
      "id": "rcTuneElf",
      "type": "promptString",
      "description": "本次 F5 加载的 ELF 路径（相对工程根目录或绝对路径）"
    },
    {
      "id": "rcTuneTclPort",
      "type": "promptString",
      "description": "F5 日志中的 Tcl 监听端口（0 表示自动识别）",
      "default": "0"
    },
    {
      "id": "elfPath",
      "type": "promptString",
      "description": "固件 ELF 路径（相对仓库根目录或绝对路径）",
      "default": "${workspaceFolder}/build/firmware.elf"
    }
  ]
}
